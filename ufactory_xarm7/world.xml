<mujoco model="orchard_world">

    <include file="xarm7.xml"/>

    <option gravity="0 0 -9.81"/>

    <visual>
        <map znear="0.01" zfar="50"/>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.4 0.4 0.4" specular="0.2 0.2 0.2"/>
    </visual>

    <asset>
        <texture type="skybox" file="background.png" gridsize="1 1"/>
        <texture name="ground_tex" type="2d" builtin="checker"
                 rgb1="0.2 0.3 0.2"
                 rgb2="0.1 0.2 0.1"
                 width="512" height="512"/>
        <material name="ground_mat"
                  texture="ground_tex"
                  texrepeat="10 10"/>
    </asset>

    <worldbody>

        <light pos="0 0 5" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
        <light pos="2 2 4" dir="-1 -1 -1" diffuse="0.5 0.5 0.45"/>
        <light pos="-2 -1 3" dir="1 0.5 -1" diffuse="0.3 0.3 0.35"/>

        <geom type="plane"
              size="10 10 0.1"
              material="ground_mat"/>

        <!-- ======================================================
             Tomato vine: a single horizontal branch carrying three
             spring peduncles.  The vine itself is world-fixed (no
             joint).  Each peduncle is a 2-segment rigid chain with
             ball joints (stiffness + damping) so it deflects on
             contact and springs back.
        ====================================================== -->
        <body name="vine" pos="0.55 0.00 1.10">

            <!-- Main vine stem running along Y -->
            <geom type="capsule" fromto="0 -0.20 0  0 0.20 0"
                  size="0.012" rgba="0.25 0.50 0.15 1"/>

            <!-- Tomato A — centre -->
            <body name="peduncle1_a" pos="0.00 0.00 0">
                <joint name="peduncle_j1_a" type="ball"
                       stiffness="60" damping="5"/>
                <geom type="capsule" fromto="0 0 0  0.00 0.00 -0.10"
                      size="0.010" rgba="0.25 0.50 0.15 1"/>
                <body name="peduncle2_a" pos="0.00 0.00 -0.10">
                    <joint name="peduncle_j2_a" type="ball"
                           stiffness="30" damping="2.5"/>
                    <geom type="capsule" fromto="0 0 0  0.00 0.00 -0.07"
                          size="0.008" rgba="0.25 0.50 0.15 1"/>
                    <body name="tomato_a" pos="0.00 0.00 -0.07">
                        <geom name="tomato_geom_a" type="sphere"
                              size="0.038" rgba="0.90 0.12 0.05 1"/>
                    </body>
                </body>
            </body>

            <!-- Tomato B — left along vine -->
            <body name="peduncle1_b" pos="0.00 -0.15 0">
                <joint name="peduncle_j1_b" type="ball"
                       stiffness="60" damping="5"/>
                <geom type="capsule" fromto="0 0 0  0.00 0.00 -0.10"
                      size="0.010" rgba="0.25 0.50 0.15 1"/>
                <body name="peduncle2_b" pos="0.00 0.00 -0.10">
                    <joint name="peduncle_j2_b" type="ball"
                           stiffness="30" damping="2.5"/>
                    <geom type="capsule" fromto="0 0 0  0.00 0.00 -0.07"
                          size="0.008" rgba="0.25 0.50 0.15 1"/>
                    <body name="tomato_b" pos="0.00 0.00 -0.07">
                        <geom name="tomato_geom_b" type="sphere"
                              size="0.038" rgba="0.90 0.12 0.05 1"/>
                    </body>
                </body>
            </body>

            <!-- Tomato C — right along vine -->
            <body name="peduncle1_c" pos="0.00 0.15 0">
                <joint name="peduncle_j1_c" type="ball"
                       stiffness="60" damping="5"/>
                <geom type="capsule" fromto="0 0 0  0.00 0.00 -0.10"
                      size="0.010" rgba="0.25 0.50 0.15 1"/>
                <body name="peduncle2_c" pos="0.00 0.00 -0.10">
                    <joint name="peduncle_j2_c" type="ball"
                           stiffness="30" damping="2.5"/>
                    <geom type="capsule" fromto="0 0 0  0.00 0.00 -0.07"
                          size="0.008" rgba="0.25 0.50 0.15 1"/>
                    <body name="tomato_c" pos="0.00 0.00 -0.07">
                        <geom name="tomato_geom_c" type="sphere"
                              size="0.038" rgba="0.90 0.12 0.05 1"/>
                    </body>
                </body>
            </body>

        </body>

    </worldbody>

</mujoco>
